@model IEnumerable<Web_ban_do_thu_cong_my_nghe.Data.User>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Khách hàng</h1>
        <p class="page-subtitle">Danh sách người dùng và trạng thái tài khoản</p>
    </div>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Tên</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Tình trạng</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model)
                {
                    <tr>
                        <td>@customer.Fullname</td>
                        <td>@customer.Email</td>
                        <td>@customer.PhoneNumber</td>
                        <td>
                            <span class="badge @(customer.Status ? "badge-success" : "badge-danger")">
                                @(customer.Status ? "Hoạt động" : "Đã khóa")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-outline">Chi tiết</a>
                            <form asp-action="ToggleLock" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@customer.Id" />
                                <button type="submit" class="btn btn-sm @(customer.Status ? "btn-warning" : "btn-success")">
                                    @(customer.Status ? "Khóa" : "Mở khóa")
                                </button>
                                @Html.AntiForgeryToken()
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
