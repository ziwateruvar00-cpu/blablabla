@model IEnumerable<Web_ban_do_thu_cong_my_nghe.Data.NhanVien>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Nhân viên</h1>
        <p class="page-subtitle">Danh sách nhân sự và phân quyền</p>
    </div>
    <div class="header-actions">
        <a asp-action="Create" class="btn btn-primary">+ Thêm nhân viên</a>
    </div>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Mã NV</th>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Mật khẩu</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var staff in Model)
                {
                    <tr>
                        <td>#@staff.MaNV</td>
                        <td>@staff.HoTen</td>
                        <td>@staff.Email</td>
                        <td><span class="text-muted">@staff.MatKhau</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@staff.MaNV" class="btn btn-sm btn-outline">Sửa</a>
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Xóa nhân viên này?');">
                                <input type="hidden" name="id" value="@staff.MaNV" />
                                <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                                @Html.AntiForgeryToken()
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
