@model Web_ban_do_thu_cong_my_nghe.ViewModels.LoginVM
@{
    var loginTitle = ViewBag.LoginTitle as string ?? "Đăng nhập";
    var loginDescription = ViewBag.LoginDescription as string;
    var formAction = ViewBag.FormAction as string ?? "DangNhap";
    var formController = ViewBag.FormController as string ?? "KhachHang";
    var showForgot = ViewBag.ShowForgot is bool flag ? flag : true;
    var returnUrl = ViewBag.ReturnUrl as string;
    ViewData["Title"] = loginTitle;
}

<div class="container-fluid bg-light overflow-hidden py-5">
    <div class="container py-5">
        <h1 class="mb-4 wow fadeInUp" data-wow-delay="0.1s">@loginTitle</h1>
        @if (!string.IsNullOrWhiteSpace(loginDescription))
        {
            <p class="text-muted">@loginDescription</p>
        }

        
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <form asp-action="@formAction" asp-controller="@formController" method="post">
            @Html.AntiForgeryToken()
            @if (!string.IsNullOrEmpty(returnUrl))
            {
                <input type="hidden" name="ReturnUrl" value="@returnUrl" />
            }
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="row">
                <div class="col-md-12 col-lg-6">
                    <div class="form-item w-100">
                        <label asp-for="TenDangNhap" class="form-label my-3">Tên đăng nhập</label><sup>*</sup>
                        <input asp-for="TenDangNhap" class="form-control" />
                        <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-12 col-lg-6">
                    <div class="form-item w-100">
                        <label asp-for="Password" class="form-label my-3"></label><sup>*</sup>
                        <input asp-for="Password" class="form-control" type="password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-4 text-center align-items-center justify-content-center pt-4">
                    <button type="submit" class="btn btn-primary border-secondary py-3 px-4 text-uppercase w-100 text-primary">
                        Đăng Nhập
                    </button>
                    @if (showForgot)
                    {
                        <a asp-controller="KhachHang" asp-action="QuenMatKhau" class="btn border-danger">
                            Quên mật khẩu
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>


