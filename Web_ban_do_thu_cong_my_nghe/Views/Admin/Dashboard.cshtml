@using Web_ban_do_thu_cong_my_nghe.Helpers
@model Web_ban_do_thu_cong_my_nghe.ViewModels.AdminDashboardVM
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = ViewData["Title"] ?? "Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1">Tổng khách hàng</p>
                <h3 class="fw-bold">@Model.CustomerCount</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1">Nhân viên</p>
                <h3 class="fw-bold">@Model.StaffCount</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1">Tổng đơn hàng</p>
                <h3 class="fw-bold">@Model.TotalOrders</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1">Doanh thu tích luỹ</p>
                <h3 class="fw-bold text-primary">@Model.TotalRevenue.ToString("N0") đ</h3>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1">Doanh thu hôm nay</p>
                        <h3 class="fw-bold">@Model.RevenueToday.ToString("N0") đ</h3>
                    </div>
                    <span class="badge bg-primary">Ngày</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1">Doanh thu tháng</p>
                        <h3 class="fw-bold">@Model.RevenueThisMonth.ToString("N0") đ</h3>
                    </div>
                    <span class="badge bg-secondary">Tháng</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-1">Doanh thu năm</p>
                        <h3 class="fw-bold">@Model.RevenueThisYear.ToString("N0") đ</h3>
                    </div>
                    <span class="badge bg-primary text-white" style="background: linear-gradient(135deg, var(--bs-primary), var(--bs-secondary));">Năm</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1">Sản phẩm</p>
                <h3 class="fw-bold">@Model.ProductCount</h3>
                <p class="mb-0 small text-muted">Danh mục: @Model.CategoryCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1">Tồn kho</p>
                <h3 class="fw-bold">@Model.InventoryInStock</h3>
                <p class="mb-0 small text-muted">Đã bán: @Model.UnitsSold</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1">Đơn hàng</p>
                <div class="d-flex justify-content-between">
                    <div>
                        <strong>@Model.PendingOrders</strong>
                        <p class="small text-muted mb-0">Chờ xác nhận</p>
                    </div>
                    <div>
                        <strong>@Model.ShippingOrders</strong>
                        <p class="small text-muted mb-0">Đang giao</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <strong>Đơn hàng gần đây</strong>
                <a asp-controller="AdminOrder" asp-action="Index" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Ngày đặt</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentOrders.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Chưa có đơn hàng nào.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td>#@order.Id</td>
                                        <td>@order.User?.Fullname</td>
                                        <td>@order.OrderDate?.ToString("dd/MM/yyyy")</td>
                                        <td>@order.TotalMoney.ToString("N0") đ</td>
                                        <td>@OrderStatusHelper.GetLabel(order.Status)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <strong>Sản phẩm bán chạy</strong>
                <a asp-controller="AdminReport" asp-action="Index" class="btn btn-sm btn-outline-primary">Xem báo cáo</a>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @if (!Model.TopProducts.Any())
                    {
                        <li class="list-group-item text-muted">Chưa có dữ liệu bán hàng.</li>
                    }
                    else
                    {
                        foreach (var product in Model.TopProducts)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@product.Name</strong>
                                    <p class="mb-0 small text-muted">Đã bán: @product.Quantity</p>
                                </div>
                                <span class="badge bg-secondary">Tồn: @product.Stock</span>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <a class="text-decoration-none" asp-controller="AdminProduct" asp-action="Index">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5>Quản lý sản phẩm</h5>
                    <p class="text-muted mb-0">Thêm/Sửa/Xoá sản phẩm, cập nhật hình ảnh, tồn kho.</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a class="text-decoration-none" asp-controller="AdminCategory" asp-action="Index">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5>Quản lý danh mục</h5>
                    <p class="text-muted mb-0">Sắp xếp nhóm sản phẩm giúp khách hàng tìm kiếm nhanh.</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a class="text-decoration-none" asp-controller="AdminOrder" asp-action="Index">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5>Bán hàng & giao hàng</h5>
                    <p class="text-muted mb-0">Theo dõi đơn, xác nhận giao, cập nhật trạng thái.</p>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-4">
        <a class="text-decoration-none" asp-controller="AdminReport" asp-action="Index">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5>Báo cáo & thống kê</h5>
                    <p class="text-muted mb-0">Doanh thu ngày/tháng/năm, khách hàng, tồn kho, sản phẩm bán chạy.</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a class="text-decoration-none" asp-controller="AdminStaff" asp-action="Index">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5>Quản lý nhân viên</h5>
                    <p class="text-muted mb-0">Thêm mới, phân quyền, cập nhật thông tin đội ngũ.</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a class="text-decoration-none" asp-controller="AdminCustomer" asp-action="Index">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5>Quản lý khách hàng</h5>
                    <p class="text-muted mb-0">Theo dõi tài khoản, khoá/mở, xem lịch sử mua hàng.</p>
                </div>
            </div>
        </a>
    </div>
</div>
